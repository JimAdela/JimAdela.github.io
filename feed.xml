---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ "/feed.xml" | prepend: site.baseurl | prepend: site.url }}" rel="self" type="application/rss+xml" />
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% assign abs = site.url | append: site.baseurl %}
    {% assign abs_src = 'src="' | append: abs | append: '/' %}
    {% assign abs_href = 'href="' | append: abs | append: '/' %}
    {% for post in site.posts limit:20 %}
      {% assign post_link = post.url | prepend: abs %}
      {% comment %}
          阅读器不跑 MathJax，公式文章给全文只会显示一屏裸 TeX，改给摘要 + 原文链接。
          站内图片与链接是 /img/... 这样的根相对地址，阅读器里会解析到阅读器自己的域名。
      {% endcomment %}
      {% if post.math %}
        {% capture body %}<p>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</p><p>本文公式较多，阅读器里无法渲染，请<a href="{{ post_link }}">到原文阅读</a>。</p>{% endcapture %}
      {% else %}
        {% assign body = post.content | replace: 'src="/', abs_src | replace: 'href="/', abs_href %}
      {% endif %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ body | xml_escape }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>{{ post_link }}</link>
        <guid isPermaLink="true">{{ post_link }}</guid>
        {% for tag in post.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
